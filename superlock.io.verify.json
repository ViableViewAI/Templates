{
  "providerId": "superlock.io",
  "providerName": "Superlock",
  "serviceId": "verify",
  "serviceName": "Ownership verification",
  "version": 1,
  "logoUrl": "https://superlock.io/apps/superlock/favicon.svg",
  "description": "Proves to Superlock that you control this domain. Changes nothing about your website or email.",
  "variableDescription": "token: the verification code Superlock shows you",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "dc.superlock.io",
  "syncRedirectDomain": "superlock.io",
  "hostRequired": false,
  "records": [
    {
      "type": "TXT",
      "host": "@",
      "data": "superlock-verification=%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "None"
    }
  ]
}
